# Generate both secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-different-long-random-secret

# PostgreSQL connection string (recommended for deployment)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME

# Gmail SMTP (use a Google App Password, never your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=youraddress@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=youraddress@gmail.com
